# Copier ce fichier en .env.local pour le développement local.
# Aucune valeur réelle ne doit être commitée dans .env.example.

# --- Base de données (requis) ---
# Valeur par défaut cohérente avec docker-compose.yml (docker compose up -d).
DATABASE_URL="postgresql://educonnect:educonnect@localhost:5432/educonnect"

# --- Auth.js (requis) ---
# Générer avec: openssl rand -base64 32
AUTH_SECRET=""

# --- Google OAuth (optionnel en local) ---
# Si absent, la connexion Google est simplement désactivée (pas d'erreur au démarrage).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Application (requis) ---
# Utilisé pour construire les liens absolus dans les emails (vérification, etc.).
APP_URL="http://localhost:3000"

# --- Resend — email transactionnel (optionnel en local) ---
# Si absent, les emails sont journalisés en console au lieu d'être envoyés.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="EduConnect <no-reply@educonnect.fr>"

# --- Sentry — monitoring d'erreurs (optionnel en local) ---
# Si absent, l'intégration Sentry est désactivée proprement.
# NEXT_PUBLIC_SENTRY_DSN est nécessaire pour l'initialisation côté navigateur (variable exposée
# au bundle client par Next.js) ; SENTRY_DSN pour le serveur/edge. Généralement la même valeur.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
